# Production settings. Copy to `.env.production` on the server (never commit it).
# Every value marked REQUIRED must be set or the site refuses to work safely.

# REQUIRED. The public address, exactly as visitors type it (no trailing slash).
# Used for canonical links, the sitemap, share cards and structured data.
SITE_URL=https://your-domain.example

# REQUIRED. Admin sign-in. Use a long random password and a fresh random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SECRET=
# Where the one-time sign-in code is emailed. Production will NOT let anyone in
# without a working email provider below.
ADMIN_EMAIL=

# REQUIRED (an email provider). SMTP shown; Gmail needs an "app password".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PolyTime Admin <you@example.com>"
# ...or use EmailJS instead (only if SMTP_* is empty):
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=

# Contact address shown on /privacy for corrections and removal requests.
CONTACT_EMAIL=

# Event crawler (runs inside the app). Set CRAWLER_ENABLED=0 to turn it off.
CRAWLER_ENABLED=1
# Optional: hours between runs are set in crawler/config.json; this overrides it (minutes).
# CRAWL_INTERVAL_MINUTES=1440
# Optional free translation quota boost for crawled descriptions (MyMemory):
# TRANSLATE_EMAIL=
# Optional per-country HTTP proxies for sites blocked from your server's location:
# CRAWL_PROXY_CN=
# CRAWL_PROXY_KR=
