# Copy this file to .env.local and fill in real values before running the app.

# The password you'll type at /admin/login to reach the moderation queue.
ADMIN_PASSWORD=change-me

# A long random string used to sign the admin session cookie so it can't be
# forged. Generate one with: openssl rand -hex 32
ADMIN_SECRET=change-me-too

# The contact address shown on /privacy for corrections or removal requests.
# Leave empty to hide it entirely (a dev-only reminder still shows locally
# so you notice).
CONTACT_EMAIL=

# --- Event crawler (npm run crawl) — all optional ---
# Web search for the crawler (pick one; without either it only scans the seed
# sites in crawler/config.json).
#  - FREE: the address of a SearXNG instance you run yourself, e.g.
#    http://localhost:8080 (needs the json format enabled — see README).
SEARXNG_URL=
#    On Windows with SearXNG installed in WSL2 (see README), also set
#    SEARXNG_AUTOSTART=wsl to start it together with the app (optional
#    SEARXNG_WSL_DISTRO=Ubuntu, SEARXNG_WSL_DIR=~/searxng).
SEARXNG_AUTOSTART=
#  - or Brave Search API key (https://brave.com/search/api/) — paid/credit based.
BRAVE_API_KEY=
# Free description translation to English (MyMemory). Any real address raises
# the daily quota from ~5,000 to ~50,000 characters; it is sent to MyMemory.
TRANSLATE_EMAIL=
# Or self-host LibreTranslate (free, unlimited) and point at it instead:
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# For sites that can't be reached from your own network, an HTTP proxy you
# operate or rent in that country, e.g. http://user:pass@host:port. One per
# locale in crawler/config.json (proxyEnv). Leave blank to fetch directly.
CRAWL_PROXY_CN=
CRAWL_PROXY_KR=
CRAWL_PROXY_TH=
CRAWL_PROXY_JP=
CRAWL_PROXY_TW=
CRAWL_PROXY_VN=
CRAWL_PROXY_ID=
CRAWL_PROXY_US=

# The crawler starts automatically with the app (see instrumentation-node.js)
# and re-runs on the schedule in crawler/config.json (default: daily).
# Set to 0 to stop it starting with the app (you can still `npm run crawl:watch`).
CRAWLER_ENABLED=1
# Optional override of the schedule, in minutes.
CRAWL_INTERVAL_MINUTES=

# The public address of the site, e.g. https://polytime.example (no trailing slash).
# Used for canonical URLs, the sitemap, share cards and structured data. MUST be set
# correctly in production; the localhost default is only for development.
SITE_URL=

# --- Admin login: two steps (password, then a one-time code sent by email) ---
# Where the sign-in code is sent. Required: without it admin login refuses to work.
ADMIN_EMAIL=
# Option 1 (recommended): SMTP. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=you@gmail.com, and SMTP_PASS = an "app password" (Google Account >
# Security > 2-Step Verification > App passwords) — NOT your normal password.
# Spaces in the 16-character app password are ignored. Any SMTP provider works.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_FROM="PolyTime Admin <you@example.com>" (defaults to SMTP_USER),
# and SMTP_SECURE=false for STARTTLS on port 587.
SMTP_FROM=
SMTP_SECURE=
# Option 2: EmailJS (https://www.emailjs.com), used only if SMTP_* is not set. Setup:
# Email Services > connect a mailbox (Service ID); Email Templates > "To Email" =
# {{to_email}} with {{subject}}, {{code}}, {{expires_in}} in the body (Template ID);
# Account > General (Public Key); Account > Security > allow non-browser apps and
# copy the Private Key. Free tier: 200 emails/month.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# With no provider at all, development prints the code in the server console;
# production refuses to sign anyone in (it never skips the second step).
